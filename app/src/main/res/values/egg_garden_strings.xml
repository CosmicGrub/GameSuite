    <!-- Egg Garden screen strings. Keys start with egg_garden_. Spanish values are real translations; nothing is waiting for translation. -->
    <string name="egg_garden_title">Egg Garden</string>
    <string name="egg_garden_help_title">How to play Egg Garden</string>
    <string name="egg_garden_help_text">Your garden starts with a nest in the middle. On your turn, draw a tile with two squares and place it next to your garden so that at least one square touches the same colour (the nest matches anything). Eggs on the tiles are points. The biggest patch of one colour earns a bonus. Fill your garden to finish.</string>
    <string name="egg_garden_help_text_coop">Everyone builds one big garden together. Draw two tiles, talk about which fits best and place one. Collect eggs and grow big patches to earn up to three stars.</string>
    <string name="egg_garden_tut_1">Your garden starts with a nest in the middle.</string>
    <string name="egg_garden_tut_2">Tap the pile to draw a tile with two squares.</string>
    <string name="egg_garden_tut_3">Drag it next to your garden. Matching colours must touch!</string>
    <string name="egg_garden_tut_4">Tap the turn button to spin the tile.</string>
    <string name="egg_garden_tut_5">Every egg in your garden is a point.</string>
    <string name="egg_garden_tut_6_compete">The biggest patch of one colour wins a bonus!</string>
    <string name="egg_garden_tut_6_coop">Build one garden together and reach for the stars!</string>
    <string name="egg_garden_tut_7">You are ready! Tap Play.</string>
