    <!-- Bridge Builders screen strings -->
    <string name="bridge_builders_help_title">Bridge Builders</string>
    <string name="bridge_builders_help_text">Everybody builds one bridge together. Each of you has a lane and a cart that slides back and forth. Tap your lane when the cart is inside the green spot to place a plank: the nearer the middle, the sturdier the plank. A miss only makes your cart rest a moment. Nobody can build more than two planks ahead of the slowest lane, so wait for your friends. Finish every lane before the water covers the bridge, then everybody crosses together. Once the last plank is in, the water waits while everybody crosses.</string>
    <string name="bridge_builders_robot_tag">(Robot)</string>
