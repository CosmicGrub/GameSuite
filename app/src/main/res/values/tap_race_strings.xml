    <!-- Tap Race screen strings -->
    <string name="trc_help_title">Tap Race</string>
    <string name="trc_help_text">Everyone has a lane and a big pad in their own zone. Tap your pad as fast as you can once the countdown ends. Sprint: first to fill the track wins. Rhythm: tap only on the beat. Mash and Brake: stop tapping when the light turns amber, and never tap on red. Win most rounds to win the match.</string>
