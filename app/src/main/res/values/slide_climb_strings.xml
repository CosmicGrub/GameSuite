    <string name="slide_climb_help_title">Slide and Climb</string>
    <string name="slide_climb_help_text">Tap the big die to roll. Your piece hops that many squares along the numbered track. Land at the foot of a rope to climb up; land at the top of a slide and down you go. The first piece to reach square 100 wins.</string>

    <string name="slide_climb_shape_circle">circle</string>
