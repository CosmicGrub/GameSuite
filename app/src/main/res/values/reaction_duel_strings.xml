<resources>
    <string name="rd_help_title">Reaction Duel</string>
    <string name="rd_help_text">Every player has a zone and everyone plays at once: press your zone with any finger. Classic: wait for GO, and pressing early puts you out of the round. Colour match: press only when the target shape shows. Echo: tap the pattern back first. The first right answer wins the round; a dead heat is replayed.</string>
    <string name="rd_status_ready">Get ready. Hands off the buttons until the signal.</string>
    <string name="rd_status_wait_classic">Wait for GO. Pressing early puts you out of the round.</string>
    <string name="rd_status_wait_colour">Watch the shapes. Press only on the target: %1$s.</string>
    <string name="rd_status_watch">Watch the pattern.</string>
    <string name="rd_status_go">GO! Press now!</string>
    <string name="rd_status_your_turn">Your turn. Tap the pattern back.</string>
