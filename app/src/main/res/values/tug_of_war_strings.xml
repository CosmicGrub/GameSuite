<resources>
    <!-- Tug of War screen strings -->
    <string name="tow_help_title">Tug of War</string>
    <string name="tow_help_text">Everyone has a pad in their own zone. Tap to pull the marker toward your line; every pull costs stamina, so mashing wears you out. Hold your finger down to rest and charge, then let go for a heave that pulls much harder. Bring the marker over your line to win the round, and win most rounds to win the match.</string>
