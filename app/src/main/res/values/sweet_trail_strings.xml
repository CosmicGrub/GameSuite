    <string name="sweet_trail_help_title">Sweet Trail</string>
    <string name="sweet_trail_help_text">Tap the card pile to draw a card. Your piece hops to the next square with the card\'s colour. A double card hops to the second square of that colour. A landmark card jumps you forward to that place. Reach the Party Table first to win!</string>
