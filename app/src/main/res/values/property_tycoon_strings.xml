    <!-- Tide cards -->
    <string name="pt_card_tide_01">A fair wind fills your sails. Sail to Lantern Quay and collect the stipend.</string>
    <string name="pt_card_tide_02">The ferry bell rings. Ride to the nearest ferry. If it is owned, pay its owner double the fare.</string>
    <string name="pt_card_tide_03">The wheels are turning. Advance to the nearest mill or pumphouse. If it is owned, roll and pay ten times the dice.</string>
    <string name="pt_card_tide_04">A rip current drags you to the Sandbar. Go there now without collecting the stipend.</string>
    <string name="pt_card_tide_05">A calm morning on the water. Keep this card to leave the Sandbar for free.</string>
    <string name="pt_card_tide_06">The tide turns. Drift back three tiles and follow the new tile.</string>
    <string name="pt_card_tide_07">Chart the opal coast. Advance to Crown of Opals. If you pass the Quay, collect the stipend.</string>
    <string name="pt_card_tide_08">A fine fishing season. Collect 100 pearls.</string>
    <string name="pt_card_tide_09">Your lantern-oil bill is due. Pay 60 pearls.</string>
    <string name="pt_card_tide_10">Storm damage. Pay 35 pearls per cabin and 110 per resort you own.</string>
    <string name="pt_card_tide_11">A festival on the water. Pay each rival 25 pearls.</string>
    <string name="pt_card_tide_12">You win the regatta. Collect 20 pearls from each rival.</string>
    <string name="pt_card_tide_13">A fog lifts. Advance to Fogbell Lane. If you pass the Quay, collect the stipend.</string>
    <string name="pt_card_tide_14">Treasure washes ashore. Collect 150 pearls.</string>
    <string name="pt_card_tide_15">A gust carries you to Sundial Square. If you pass the Quay, collect the stipend.</string>
    <string name="pt_card_tide_16">A sudden gust shoves you forward two tiles.</string>
