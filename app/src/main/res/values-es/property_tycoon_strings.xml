    <!-- Tide cards -->
    <string name="pt_card_tide_01">Un viento favorable hincha tus velas. Navega al Muelle del Farol y cobra el estipendio.</string>
    <string name="pt_card_tide_02">Suena la campana del ferri. Ve al ferri más cercano. Si tiene dueño, paga el doble del pasaje.</string>
    <string name="pt_card_tide_03">Las ruedas giran. Avanza al molino o bombeo más cercano. Si tiene dueño, tira y paga diez veces los dados.</string>
    <string name="pt_card_tide_04">Una corriente de resaca te arrastra al Banco de Arena. Ve ahora sin cobrar el estipendio.</string>
    <string name="pt_card_tide_05">Una mañana tranquila en el agua. Guarda esta carta para salir gratis del Banco de Arena.</string>
    <string name="pt_card_tide_06">Cambia la marea. Retrocede tres casillas y cumple la nueva casilla.</string>
    <string name="pt_card_tide_07">Traza la costa de ópalos. Avanza a la Corona de Ópalos. Si pasas por el Muelle, cobra el estipendio.</string>
    <string name="pt_card_tide_08">Una gran temporada de pesca. Cobra 100 perlas.</string>
    <string name="pt_card_tide_09">Vence tu factura de aceite de farol. Paga 60 perlas.</string>
    <string name="pt_card_tide_10">Daños por tormenta. Paga 35 perlas por cabaña y 110 por complejo que tengas.</string>
    <string name="pt_card_tide_11">Fiesta sobre el agua. Paga 25 perlas a cada rival.</string>
    <string name="pt_card_tide_12">Ganas la regata. Cobra 20 perlas de cada rival.</string>
    <string name="pt_card_tide_13">Se levanta la niebla. Avanza a la Calle Campana de Niebla. Si pasas por el Muelle, cobra el estipendio.</string>
    <string name="pt_card_tide_14">El mar trae un tesoro a la orilla. Cobra 150 perlas.</string>
    <string name="pt_card_tide_15">Una ráfaga te lleva a la Plaza del Reloj de Sol. Si pasas por el Muelle, cobra el estipendio.</string>
    <string name="pt_card_tide_16">Una ráfaga repentina te empuja dos casillas hacia delante.</string>
    <!-- Guild cards -->
    <string name="pt_card_guild_01">Día de dividendos del gremio. Cobra 120 perlas.</string>
    <string name="pt_card_guild_02">El capitán de puerto te devuelve una tasa. Cobra 45 perlas.</string>
    <string name="pt_card_guild_03">Una boda en la orilla. Cobra 15 perlas de cada rival como regalo.</string>
    <string name="pt_card_guild_04">Paga 70 perlas al médico del gremio.</string>
    <string name="pt_card_guild_05">Reparación de techos en tus propiedades. Paga 30 perlas por cabaña y 95 por complejo.</string>
    <string name="pt_card_guild_06">Guarda esta carta. Te libera del Banco de Arena una vez.</string>
    <string name="pt_card_guild_07">Citación del tribunal del puerto. Ve al Banco de Arena sin cobrar el estipendio.</string>
    <string name="pt_card_guild_08">Vendes redes de pesca viejas. Cobra 60 perlas.</string>
    <string name="pt_card_guild_09">Multa de biblioteca por cartas náuticas atrasadas. Paga 25 perlas.</string>
    <string name="pt_card_guild_10">Llega una subvención para constructores. Cobra 180 perlas.</string>
    <string name="pt_card_guild_11">Cuotas de la escuela del faro. Paga 140 perlas.</string>
    <string name="pt_card_guild_12">Vuelve al Muelle del Farol y cobra el estipendio.</string>
    <string name="pt_card_guild_13">Una tía lejana te deja una herencia. Cobra 100 perlas.</string>
    <string name="pt_card_guild_14">Organizas el banquete de la comunidad. Paga 20 perlas a cada rival.</string>
    <string name="pt_card_guild_15">Ganas un concurso de cordelería. Cobra 30 perlas.</string>
    <string name="pt_card_guild_16">Se publica una devolución de impuestos. Cobra 80 perlas.</string>
