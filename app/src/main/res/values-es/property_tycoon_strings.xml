    <!-- Tutorial script -->
    <string name="pt_tut_01">Bienvenido al archipiélago. Compra casillas, cobra alquileres y supera a tus rivales.</string>
    <string name="pt_tut_02">Tira dos dados y tu ficha navega esas casillas por el anillo.</string>
    <string name="pt_tut_03">Si caes en una casilla sin dueño puedes comprarla. Las perlas son solo de juego.</string>
    <string name="pt_tut_04">Si caes en una casilla rival pagas alquiler. Con un color completo, el alquiler se duplica.</string>
    <string name="pt_tut_05">Con un color completo puedes construir cabañas. Construye de forma pareja.</string>
    <string name="pt_tut_06">Cuatro cabañas pueden convertirse en un complejo, el alquiler más alto.</string>
    <string name="pt_tut_07">Los dobles te dejan tirar otra vez. Tres seguidos te mandan al Banco de Arena.</string>
    <string name="pt_tut_08">En el Banco de Arena, saca dobles, paga la multa o usa una carta de salida libre.</string>
    <string name="pt_tut_09">Las cartas de Marea y del Gremio traen sorpresas: regalos, facturas y saltos.</string>
    <string name="pt_tut_10">¿Faltan perlas? Vende edificios o hipoteca casillas. Una casilla hipotecada no cobra alquiler.</string>
    <string name="pt_tut_11">Si no puedes pagar tu deuda, quiebras y tus casillas pasan a quien se la debes.</string>
    <string name="pt_tut_12">Gana el último en pie. En las partidas rápidas, tras 20 rondas gana el más rico.</string>
    <!-- Coach card and tips -->
    <string name="coach_property_tycoon_s1">Tira dos dados y mueve tu ficha por el anillo de 40 casillas.</string>
    <string name="coach_property_tycoon_s2">Compra las casillas en que caes, o mándalas a subasta para que un rival pague más.</string>
    <string name="coach_property_tycoon_s3">Ten todas las casillas de un color para duplicar su alquiler y construir cabañas.</string>
    <string name="coach_property_tycoon_s4">Hipoteca casillas o vende edificios si debes más perlas de las que tienes.</string>
    <string name="coach_property_tycoon_s5">Sé el último en pie, o el más rico cuando llegue el límite de rondas.</string>
    <string name="coach_property_tycoon_fact">Juegos como este nacieron hace un siglo como un tablero de protesta que mostraba cómo el alquiler se acumula en pocas manos.</string>
    <string name="draft_tip_property_tycoon_1">Los colores completos importan más que las casillas sueltas. Intercambia para completar uno.</string>
    <string name="draft_tip_property_tycoon_2">Guarda un colchón de perlas. Un solo alquiler de complejo puede acabar contigo.</string>
    <string name="draft_tip_property_tycoon_3">Tres cabañas es el punto ideal: el alquiler sube más por lo que cuestan.</string>
