    <string name="arena_title">Arena de computadoras</string>
    <string name="arena_subtitle">Mira a dos computadoras jugar entre sí, jugada a jugada, en la pantalla real del juego. Nada de esto toca tus estadísticas, rachas, logros ni partidas guardadas.</string>
    <string name="arena_card_title">Arena de computadoras</string>
    <string name="arena_card_body">Mira a las computadoras enfrentarse: elige un juego, dos niveles y cuántas partidas.</string>
