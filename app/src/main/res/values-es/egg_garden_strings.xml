    <!-- Egg Garden screen strings. Keys start with egg_garden_. Spanish values are real translations; nothing is waiting for translation. -->
    <string name="egg_garden_title">Jardín de Huevos</string>
    <string name="egg_garden_help_title">Cómo se juega a Jardín de Huevos</string>
    <string name="egg_garden_help_text">Tu jardín empieza con un nido en el centro. En tu turno, saca una ficha de dos cuadros y colócala junto a tu jardín para que al menos un cuadro toque el mismo color (el nido combina con todo). Los huevos de las fichas son puntos. El parche más grande de un color da un bonus. Llena tu jardín para terminar.</string>
    <string name="egg_garden_help_text_coop">Todos construyen juntos un jardín grande. Saca dos fichas, hablen de cuál encaja mejor y coloquen una. Reúnan huevos y hagan parches grandes para ganar hasta tres estrellas.</string>
    <string name="egg_garden_tut_1">Tu jardín empieza con un nido en el centro.</string>
    <string name="egg_garden_tut_2">Toca el montón para sacar una ficha de dos cuadros.</string>
    <string name="egg_garden_tut_3">Arrástrala junto a tu jardín. ¡Los colores iguales deben tocarse!</string>
    <string name="egg_garden_tut_4">Toca el botón de girar para dar la vuelta a la ficha.</string>
    <string name="egg_garden_tut_5">Cada huevo de tu jardín es un punto.</string>
    <string name="egg_garden_tut_6_compete">¡El parche más grande de un color gana un bonus!</string>
    <string name="egg_garden_tut_6_coop">¡Construyan un jardín juntos y alcancen las estrellas!</string>
    <string name="egg_garden_tut_7">¡Listos! Toca Jugar.</string>
